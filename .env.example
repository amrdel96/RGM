# Copy to .env.local locally; hosted values go in Vercel Environment Variables.
# Never replace an existing .env.local or commit populated credentials.
APP_ENV=local
DB_MODE=pglite
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Hosted: APP_ENV=staging or production, DB_MODE=postgres, https site URL.
DATABASE_URL=
DATABASE_SSL=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# mock | smtp | resend | postmark
EMAIL_PROVIDER=mock
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_API_KEY=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
# mock | meta | wati; enable sending separately in /admin/settings.
WHATSAPP_PROVIDER=mock
WHATSAPP_API_KEY=
# Meta: phone-number ID, supported Graph version, app secret, verification token.
WHATSAPP_PHONE_ID=
META_GRAPH_VERSION=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_VERIFY_TOKEN=
# WATI delivery-status webhook is not implemented.
WATI_API_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Generate with: node scripts/prepare-integration-secrets.mjs
CRON_SECRET=
UPLOAD_TOKEN_SECRET=
# Comma-separated exact email addresses/international numbers allowed in staging.
TEST_RECIPIENT_ALLOWLIST=
# Recipient mailboxes, contacts, template names and analytics IDs: /admin/settings.
